#!/bin/bash
set -e  # Exit on any error
set -x  # Print commands as they execute

# ============================================================================
# Container Sync Script - Automation-core propagation for a single branch
# ============================================================================
#
# This script runs inside Docker containers to sync automation-core
# infrastructure to a specific branch.
#
# Usage: /sync.sh <branch-name>
#   Example: /sync.sh dev-v2.15
#
# ============================================================================

BRANCH=$1

if [[ -z "$BRANCH" ]]; then
    echo "ERROR: Branch name required" >&2
    echo "Usage: $0 <branch-name>" >&2
    exit 1
fi

# ============================================================================
# Internal Functions
# ============================================================================
# Dependencies pre-installed in Docker image

checkout_target_branch() {
    echo "[INFO] Fetching branch: $BRANCH"
    git fetch upstream $BRANCH --depth 1
    git checkout FETCH_HEAD
    git checkout -B $BRANCH
    git pull upstream $BRANCH --depth 1
    echo "[PASS] Branch checked out: $BRANCH"
}

fetch_automation_core() {
    echo '[INFO] Fetching automation-core...'
    git fetch upstream +automation-core:refs/remotes/upstream/automation-core --depth 1
    echo '[DEBUG] Available refs:'
    git show-ref
    echo '[PASS] automation-core fetched'
}

sync_pull_scripts() {
    echo '[INFO] Updating pull-scripts from automation-core...'
    git show upstream/automation-core:scripts/pull-scripts > scripts/pull-scripts
    chmod +x scripts/pull-scripts
    echo '[PASS] pull-scripts updated'
}

run_pull_scripts() {
    echo '[INFO] Running pull-scripts (syncs .gitignore and Makefile)...'
    SKIP_PS=true ./scripts/pull-scripts
    echo '[PASS] pull-scripts completed'
}

import_workflows() {
    if [[ "$BRANCH" == release-v* ]]; then
        echo '[INFO] Importing workflows (release mode)...'
        ./scripts/import-workflows --release
    else
        echo '[INFO] Importing workflows (dev mode)...'
        ./scripts/import-workflows
    fi
    echo '[PASS] Workflows imported'
}

derive_propagate_branch_name() {
    local target_branch=$1
    local propagate_branch=""

    if [[ "$target_branch" =~ ^dev-v2\.([0-9]+)$ ]]; then
        # dev-v2.15 → propagate-dev-15
        propagate_branch="propagate-dev-${BASH_REMATCH[1]}"
    elif [[ "$target_branch" =~ ^release-v2\.([0-9]+)$ ]]; then
        # release-v2.14 → propagate-rel-14
        propagate_branch="propagate-rel-${BASH_REMATCH[1]}"
    else
        echo "[ERROR] Unknown branch pattern: $target_branch" >&2
        return 1
    fi

    echo "$propagate_branch"
}

checkout_propagate_branch() {
    local propagate_branch=$1

    echo "[INFO] Creating propagate branch: $propagate_branch"
    git checkout -B "$propagate_branch"
    echo "[PASS] Checked out propagate branch: $propagate_branch"
}

stage_and_commit() {
    local path=$1

    if [[ -z "$path" ]]; then
        echo '[ERROR] stage_and_commit requires a path argument'
        return 1
    fi

    # Check if there are changes at the specified path
    if git diff --quiet "$path" && git diff --cached --quiet "$path"; then
        echo "[DEBUG] No changes to commit for: $path"
        return 0
    fi

    # Stage the path
    echo "[DEBUG] Staging: $path"
    git add "$path"

    # Generate dynamic commit message based on path
    commit_msg="chore(automation-core): sync $path from automation-core"

    echo "[DEBUG] Creating commit: $commit_msg"
    git commit -m "$commit_msg"
    echo "[PASS] Committed changes for: $path"
}

generate_pr_body() {
    local current_date
    current_date=$(date +%Y-%m-%d)

    local cbs_version
    cbs_version=$(/repo/bin/charts-build-scripts --version | awk '{print $3}')

    cat <<EOF
## Summary

Automated propagation Sync from \`automation-core\` branch:

- .gitignore
- Makefile
- .github/workflows
- scripts/pull-scripts

---

Built for charts-build-scripts version: $cbs_version

$current_date
EOF
}

push_and_create_pr() {
    local propagate_branch=$1

    # Configure git to use gh for authentication
    git config --global --unset-all credential.helper || true
    git config --global --add credential.helper '!gh auth git-credential'

    echo "[INFO] Pushing to upstream: $propagate_branch"
    git push -u upstream "$propagate_branch" --force

    echo "[PASS] Pushed to upstream/$propagate_branch"

    # Check if open PR already exists for this branch
    local existing_pr
    existing_pr=$(gh pr list --head "$propagate_branch" --state open --json number -q '.[0].number' 2>/dev/null || true)

    if [[ -n "$existing_pr" ]]; then
        echo "[INFO] Open PR already exists: #$existing_pr"
        echo "[INFO] Skipping PR creation (branch updated via force push)"
    else
        echo "[INFO] Creating pull request..."
        local pr_body
        pr_body=$(generate_pr_body)

        gh pr create \
            --base "$BRANCH" \
            --head "$propagate_branch" \
            --title "[$BRANCH] infra propagation" \
            --body "$pr_body"

        echo "[PASS] Pull request created"
    fi
}

# ============================================================================
# Main Execution
# ============================================================================

main() {
    echo '================================================================='
    echo "Branch Sync - $BRANCH"
    echo '================================================================='
    echo ''

    cd /repo

    # Setup workspace and git
    checkout_target_branch
    fetch_automation_core

    # Derive propagate branch name and checkout
    local propagate_branch
    propagate_branch=$(derive_propagate_branch_name "$BRANCH")
    checkout_propagate_branch "$propagate_branch"

    # Sync automation-core infrastructure
    sync_pull_scripts
    run_pull_scripts
    import_workflows

    # Files/directories modified during sync that need to be committed
    local paths_to_commit=(
        ".gitignore"
        "Makefile"
        ".github/workflows/"
        "scripts/pull-scripts"
    )

    # Stage and commit changes
    echo '[INFO] Processing sync changes...'
    for path in "${paths_to_commit[@]}"; do
        stage_and_commit "$path"
    done

    # Push and create PR
    push_and_create_pr "$propagate_branch"

    git status
    echo ''
    echo '================================================================='
    echo 'Sync completed successfully'
    echo '================================================================='
}

main
