#!/bin/bash
set -e

# ============================================================================
# Propagate Automation-Core - Sync infrastructure to active branches
# ============================================================================
#
# WHAT IS THIS?
#   Propagates automation-core infrastructure changes (scripts, workflows,
#   Makefile, .gitignore) to active dev-v* and release-v* branches using
#   Docker containers for isolation. Creates PRs for each branch.
#
# HOW IT WORKS:
#   1. Reads branch list from scripts/automation/propagate.yaml
#   2. Validates authentication (git + gh cli)
#   3. For each branch (in parallel):
#      - Spins up Docker container
#      - Fresh clone of repository
#      - Creates feature branch
#      - Runs sync-branch script (pull-scripts + import-workflows)
#      - Pushes and creates PR
#   4. Monitors container logs and reports results
#
# USAGE:
#   make propagate
#
#   The script will:
#   - Read branches from propagate.yaml
#   - Show summary and ask for confirmation
#   - Launch parallel Docker containers for each branch
#   - Create PRs for successful syncs
#   - Report failures
#
# REQUIREMENTS:
#   - Docker installed and running
#   - Git authenticated (push access to rancher/charts)
#   - GitHub CLI authenticated (gh auth status)
#   - yq installed (for YAML parsing)
#
# ============================================================================

cd "$(dirname "$0")"
cd ../..

# Source the container setup functions
source "$(dirname "$0")/container-setup"

# ============================================================================
# Global Variables
# ============================================================================

# Paths
CONFIG_FILE="scripts/automation/propagate.yaml"
LOG_DIR="logs/propagate"

# Docker configuration
DOCKER_IMAGE="registry.suse.com/bci/bci-base:latest"

# Colors
RESET='\033[0m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
MAGENTA='\033[0;95m'

# Branch tracking
declare -a DEV_BRANCHES
declare -a RELEASE_BRANCHES
declare -a ALL_BRANCHES
declare -a CONTAINER_NAMES
declare -A PR_URLS  # Associative array: branch -> PR URL

# ============================================================================
# Logging Functions
# ============================================================================

log_info() {
    echo -e "${BLUE}[INFO]${RESET} $1"
}

log_success() {
    echo -e "${GREEN}[PASS]${RESET} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARN]${RESET} $1"
}

log_error() {
    echo -e "${RED}[FAIL]${RESET} $1" >&2
}

log_debug() {
    echo -e "${MAGENTA}[DEBUG]${RESET} $1"
}

print_header() {
    echo "================================================================="
    echo "$1"
    echo "================================================================="
}

print_separator() {
    echo "-------------------------------------------------------------------"
}

# ============================================================================
# Validation Functions
# ============================================================================

validate_dependencies() {
    log_success "validate_dependencies"
    log_info "Checking required tools..."

    # Check Docker
    if ! command -v docker &> /dev/null; then
        log_error "Docker not found. Install Docker first."
        exit 1
    fi

    if ! docker info &> /dev/null; then
        log_error "Docker daemon not running. Start Docker first."
        exit 1
    fi
    log_debug "✓ Docker available"

    # Check yq
    if ! command -v yq &> /dev/null; then
        log_error "yq not found. Install yq for YAML parsing."
        exit 1
    fi
    log_debug "✓ yq available"

    # Check gh
    if ! command -v gh &> /dev/null; then
        log_error "GitHub CLI (gh) not found. Install gh first."
        exit 1
    fi
    log_debug "✓ gh available"

    # Check gh authentication
    if ! gh auth status &> /dev/null; then
        log_error "GitHub CLI not authenticated. Run 'gh auth login' first."
        exit 1
    fi
    log_debug "✓ gh authenticated"

    # Check git authentication
    if ! git config user.email &> /dev/null; then
        log_error "Git user.email not configured. Run 'git config --global user.email <email>'"
        exit 1
    fi
    log_debug "✓ git configured"

    log_success "All dependencies validated"
    echo ""
}

validate_config_file() {
    log_success "validate_config_file"
    log_info "Checking configuration file..."

    if [[ ! -f "$CONFIG_FILE" ]]; then
        log_error "Configuration file not found: $CONFIG_FILE"
        exit 1
    fi
    log_debug "✓ Configuration file exists"

    # Validate YAML structure
    if ! yq '.dev' "$CONFIG_FILE" &> /dev/null; then
        log_error "Invalid YAML: missing 'dev' section"
        exit 1
    fi

    if ! yq '.release' "$CONFIG_FILE" &> /dev/null; then
        log_error "Invalid YAML: missing 'release' section"
        exit 1
    fi
    log_debug "✓ YAML structure valid"

    log_success "Configuration file validated"
    echo ""
}

# ============================================================================
# Container Management
# ============================================================================

build_docker_image() {
    log_success "build_docker_image"
    local dockerfile="scripts/automation/Dockerfile"
    local image_tag="rancher-charts-propagate:local"

    # Check if image already exists
    if docker images --format "{{.Repository}}:{{.Tag}}" | grep -q "^${image_tag}$"; then
        log_info "Image already exists: $image_tag"
        log_debug "Skipping build (use 'make reset-propagate' to rebuild)"
        echo ""
        return 0
    fi

    log_info "Building Docker image with dependencies..."
    echo ""

    if ! docker build -t "$image_tag" -f "$dockerfile" scripts/automation/; then
        log_error "Failed to build Docker image"
        exit 1
    fi

    log_success "Image built: $image_tag"
    echo ""
}

# start_container function is sourced from container-setup script

sync_all_branches() {
    log_success "sync_all_branches"
    log_info "Syncing ${#ALL_BRANCHES[@]} branch(es) sequentially..."
    echo ""

    local count=0
    for i in "${!ALL_BRANCHES[@]}"; do
        local branch="${ALL_BRANCHES[$i]}"
        local container_name="${CONTAINER_NAMES[$i]}"
        count=$((count + 1))

        print_separator
        log_info "[$count/${#ALL_BRANCHES[@]}] Processing branch: $branch"
        print_separator

        # Capture PR URL from start_container
        local pr_url
        pr_url=$(start_container "$container_name" "$branch")
        local exit_code=$?

        if [[ $exit_code -ne 0 ]]; then
            log_error "Sync failed for branch: $branch"
            log_error "Aborting remaining branches (fail-fast mode)"
            exit 1
        fi

        # Store PR URL
        PR_URLS["$branch"]="$pr_url"
        log_debug "Stored PR URL for $branch: $pr_url"

        log_success "Completed: $branch"
        echo ""
    done

    log_success "All branches synced successfully"
    echo ""

    # Display created PRs
    print_header "Created Propagation PRs"
    for branch in "${ALL_BRANCHES[@]}"; do
        echo "  - $branch: ${PR_URLS[$branch]}"
    done
    echo ""
}

create_meta_pr() {
    log_success "create_meta_pr"
    log_info "Creating meta-PR against automation-core..."
    echo ""

    # Generate branch name with date
    local meta_branch="propagate-batch-$(date +%Y-%m-%d)"
    local current_branch
    current_branch=$(git branch --show-current)

    log_debug "Current branch: $current_branch"
    log_debug "Meta branch: $meta_branch"

    # Checkout automation-core and create meta branch
    log_info "Creating meta branch: $meta_branch"
    git fetch upstream automation-core --depth 1
    git checkout -B automation-core upstream/automation-core
    git checkout -B "$meta_branch"

    # Stage and commit propagate.yaml
    log_info "Committing propagate.yaml..."
    git add scripts/automation/propagate.yaml
    git commit -m "chore(automation): propagate infrastructure to ${#ALL_BRANCHES[@]} branches"

    # Push meta branch
    log_info "Pushing meta branch to upstream..."
    git push -u upstream "$meta_branch" --force

    # Generate PR body from template
    local current_date
    current_date=$(date +%Y-%m-%d)

    local cbs_version
    cbs_version=$(./bin/charts-build-scripts --version | awk '{print $3}')

    local pr_list=""
    for branch in "${ALL_BRANCHES[@]}"; do
        pr_list+="- $branch: ${PR_URLS[$branch]}"$'\n'
    done

    local pr_body
    pr_body=$(cat scripts/automation/propagate-meta-template.md)
    pr_body="${pr_body//\{\{BRANCH_COUNT\}\}/${#ALL_BRANCHES[@]}}"
    pr_body="${pr_body//\{\{PR_LIST\}\}/$pr_list}"
    pr_body="${pr_body//\{\{CBS_VERSION\}\}/$cbs_version}"
    pr_body="${pr_body//\{\{DATE\}\}/$current_date}"

    # Create meta-PR
    log_info "Creating meta-PR..."
    local meta_pr_url
    meta_pr_url=$(gh pr create \
        --base automation-core \
        --head "$meta_branch" \
        --title "[automation-core] propagate infrastructure to ${#ALL_BRANCHES[@]} branches" \
        --body "$pr_body")

    # Return to original branch
    git checkout "$current_branch"

    log_success "Meta-PR created: $meta_pr_url"
    echo ""

    # Return meta-PR URL
    echo "$meta_pr_url"
}

ask_stop_containers() {
    echo ""
    log_info "Containers are still running for inspection"
    echo -n "Stop all propagate containers? (y/N): "
    read -r response

    if [[ "$response" =~ ^[Yy]$ ]]; then
        log_info "Stopping propagate containers..."
        local container_ids
        container_ids=$(docker ps --filter "name=_propagate" -q)

        if [[ -n "$container_ids" ]]; then
            echo "$container_ids" | xargs docker stop &> /dev/null
            local count=$(echo "$container_ids" | wc -l)
            log_success "Stopped $count container(s)"
        else
            log_debug "No running containers found"
        fi
    else
        log_info "Containers kept running - use 'make reset-propagate' to clean up"
    fi
    echo ""
}

# Cleanup handled by reset-propagate script instead of automatic cleanup

# ============================================================================
# Configuration Parsing
# ============================================================================

parse_branches() {
    log_success "parse_branches"
    log_info "Reading branches from $CONFIG_FILE..."

    # Parse dev branches
    for version in $(yq '.dev[]' "$CONFIG_FILE"); do
        DEV_BRANCHES+=("dev-v2.$version")
    done

    # Parse release branches
    for version in $(yq '.release[]' "$CONFIG_FILE"); do
        RELEASE_BRANCHES+=("release-v2.$version")
    done

    # Combine all branches
    ALL_BRANCHES=("${DEV_BRANCHES[@]}" "${RELEASE_BRANCHES[@]}")

    log_debug "Dev branches: ${#DEV_BRANCHES[@]}"
    log_debug "Release branches: ${#RELEASE_BRANCHES[@]}"
    log_success "Parsed ${#ALL_BRANCHES[@]} total branch(es)"
    echo ""
}

build_container_names() {
    log_success "build_container_names"
    log_info "Building container names..."

    for branch in "${ALL_BRANCHES[@]}"; do
        CONTAINER_NAMES+=("${branch}_propagate")
    done

    log_debug "Container names: ${#CONTAINER_NAMES[@]}"
    log_success "Container names built"
    echo ""
}

display_summary() {
    log_success "display_summary"
    print_header "Propagation Summary"
    echo ""

    echo "Dev branches (${#DEV_BRANCHES[@]}):"
    for branch in "${DEV_BRANCHES[@]}"; do
        echo "  - $branch"
    done
    echo ""

    echo "Release branches (${#RELEASE_BRANCHES[@]}):"
    for branch in "${RELEASE_BRANCHES[@]}"; do
        echo "  - $branch"
    done
    echo ""

    echo "Total branches: ${#ALL_BRANCHES[@]}"
    echo ""
}

ask_confirmation() {
    log_success "ask_confirmation"
    print_separator

    read -p "Propagate automation-core to these branches? [y/N]: " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        log_warning "User aborted"
        exit 0
    fi

    log_debug "User confirmed"
    echo ""
}

# ============================================================================
# Main
# ============================================================================

main() {
    log_success "main"
    log_debug "Script started"
    log_debug "Working directory: $(pwd)"

    print_header "Propagate Automation-Core"
    echo ""

    # Validate environment
    validate_dependencies
    validate_config_file

    # Parse configuration
    parse_branches
    build_container_names
    display_summary
    ask_confirmation

    # Build Docker image with dependencies and rancher/charts clone
    build_docker_image

    # Sync all branches sequentially (fail-fast)
    sync_all_branches

    # Create meta-PR against automation-core
    local meta_pr_url
    meta_pr_url=$(create_meta_pr)

    # Display meta-PR URL
    print_header "Meta-PR Created"
    echo "  $meta_pr_url"
    echo ""

    # Ask user if they want to stop containers
    ask_stop_containers

    log_success "Propagation completed successfully"
    log_debug "Script completed"
}

main "$@"
