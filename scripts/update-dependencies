#!/bin/bash
set -e

# ============================================================================
# Update Dependencies - Automated dependency version and checksum updates
# ============================================================================
#
# WHAT IS THIS?
#   Script that checks for updated versions and checksums of pinned system
#   dependencies (docker, jq, git, make, go, patch, gawk) and GitHub release
#   packages (yq, gh). When SUSE rebuilds packages or GitHub releases new
#   versions, this script detects the changes and updates the dependencies
#   action YAML file with new checksums.
#
# WHY DOES IT EXIST?
#   SUSE periodically rebuilds packages in their repositories (security patches,
#   compiler updates, toolchain changes). When this happens, the binary checksum
#   changes even though the version stays the same. Without this script,
#   maintainers would need to manually:
#   1. Spin up BCI container
#   2. Install each package
#   3. Calculate checksums
#   4. Update action.yaml by hand
#   5. Test changes
#
#   This script automates the entire process and runs on a schedule to prevent
#   checksum mismatches from blocking PRs during release windows.
#
# HOW IT WORKS:
#   DUAL-MODE EXECUTION:
#     - Local (Docker mode): Runs in isolated containers to avoid installing
#       packages on developer's machine. Preserves clean local environment.
#     - CI (Direct mode): Installs packages directly on ephemeral runner.
#       Faster execution, no Docker-in-Docker complexity.
#
#   EXECUTION FLOW:
#     1. Detect mode (CI env var set = direct install, unset = Docker)
#     2. Fetch latest versions in parallel (9 packages, ~30 seconds):
#        - Zypper packages: Install from SUSE repos, extract version + checksum
#        - GitHub packages: Download release asset, calculate checksum
#     3. Parse current values from action.yaml
#     4. Build comparison table (current vs latest)
#     5. Prompt for confirmation (or auto-approve in CI)
#     6. Update action.yaml with sed replacements
#
#   PARALLEL EXECUTION:
#     Spins up 9 background jobs (zypper packages + GitHub releases) to fetch
#     versions/checksums concurrently. Waits for all to complete before parsing.
#
# USAGE:
#   Local (interactive):
#     ./scripts/update-dependencies
#     # Uses Docker containers, prompts for confirmation
#
#   CI (automated):
#     CI=true ./scripts/update-dependencies
#     # Installs directly on runner, auto-approves changes
#
#   The workflow at .github/workflows/update-dependencies.yaml runs this
#   script on a schedule (every 6 hours) and when triggered by checksum
#   mismatch events from the verify-checksum script.
#
# ============================================================================

cd "$(dirname "$0")"
cd ..

# ============================================================================
# Global Variables
# ============================================================================

# Colors
RESET='\033[0m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
MAGENTA='\033[0;95m'  # Cyberpunk pink for debug

# Paths
ACTION_FILE=".github/actions/dependencies/action.yaml"
TEMP_DIR=$(mktemp -d)

# Package mapping: package_name:binary_path:yaml_display_name
declare -A PACKAGES=(
  ["docker"]="/usr/bin/docker:Docker"
  ["jq"]="/usr/bin/jq:jq"
  ["git"]="/usr/bin/git:git"
  ["make"]="/usr/bin/make:make"
  ["go"]="/usr/bin/go:go"
  ["patch"]="/usr/bin/patch:patch"
  ["gawk"]="/usr/bin/gawk:gawk"
)

# GitHub release packages: package_name:install_path:yaml_display_name:repo:asset_pattern
declare -A GITHUB_PACKAGES=(
  ["yq"]="/usr/bin/yq:yq:mikefarah/yq:yq_linux_amd64"
  ["gh"]="/usr/bin/gh:gh:cli/cli:gh_{VERSION}_linux_amd64.tar.gz"
)

# Version and checksum storage
declare -A CURRENT_VERSIONS
declare -A CURRENT_CHECKSUMS
declare -A NEW_VERSIONS
declare -A NEW_CHECKSUMS

# Execution mode
USE_DOCKER=true
MODE=""

# ============================================================================
# Logging Functions
# ============================================================================

log_info() {
    echo -e "${BLUE}[INFO]${RESET} $1"
}

log_success() {
    echo -e "${GREEN}[PASS]${RESET} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARN]${RESET} $1"
}

log_error() {
    echo -e "${RED}[FAIL]${RESET} $1" >&2
}

log_debug() {
    echo -e "${MAGENTA}[DEBUG]${RESET} $1"
}

print_header() {
    echo "================================================================="
    echo "$1"
    echo "================================================================="
}

print_separator() {
    echo "-------------------------------------------------------------------"
}

# ============================================================================
# Helper Functions
# ============================================================================

get_current_version() {
  local display_name=$1
  grep -A 5 "name: Install $display_name" "$ACTION_FILE" | \
    grep "PACKAGE_VERSION:" | \
    sed 's/.*PACKAGE_VERSION: "\(.*\)"/\1/'
}

get_current_checksum() {
  local display_name=$1
  grep -A 5 "name: Install $display_name" "$ACTION_FILE" | \
    grep "EXPECTED_CHECKSUM:" | \
    sed 's/.*EXPECTED_CHECKSUM: "\(.*\)"/\1/'
}

get_current_yq_version() {
  local display_name=$1
  grep -A 5 "name: Install $display_name" "$ACTION_FILE" | \
    grep "YQ_VERSION:" | \
    sed 's/.*YQ_VERSION: "\(.*\)"/\1/'
}

get_current_gh_version() {
  local display_name=$1
  grep -A 5 "name: Install $display_name" "$ACTION_FILE" | \
    grep "GH_VERSION:" | \
    sed 's/.*GH_VERSION: "\(.*\)"/\1/'
}

escape_for_sed() {
  echo "$1" | sed 's/[\/&]/\\&/g'
}

cleanup() {
  rm -rf "$TEMP_DIR"
}

# ============================================================================
# Core Functions
# ============================================================================

detect_mode() {
  log_success "detect_mode"

  if [[ -n "${CI}" ]]; then
    USE_DOCKER=false
    MODE="CI (direct install)"
    log_debug "CI env var detected: USE_DOCKER=false"
  else
    USE_DOCKER=true
    MODE="Local (Docker isolation)"
    log_debug "CI env var not set: USE_DOCKER=true"
  fi

  print_header "Dependency Version Update Script"
  log_info "Execution mode: $MODE"
  echo ""
}

fetch_zypper_package() {
  local pkg=$1
  local binary_path=$2

  if [[ "$USE_DOCKER" == "true" ]]; then
    # Docker mode: Run in isolated container
    docker run --rm --name "bci-base_$pkg" registry.suse.com/bci/bci-base:latest bash -c "
      zypper --non-interactive refresh &>/dev/null
      zypper --non-interactive install $pkg &>/dev/null
      rpm -q $pkg
      sha256sum $binary_path | cut -d' ' -f1
    " > "$TEMP_DIR/$pkg.txt" 2>&1
  else
    # CI mode: Install directly on runner
    {
      zypper --non-interactive refresh &>/dev/null
      zypper --non-interactive install "$pkg" &>/dev/null
      rpm -q "$pkg"
      sha256sum "$binary_path" | cut -d' ' -f1
    } > "$TEMP_DIR/$pkg.txt" 2>&1
  fi

  # Read results
  local version
  local checksum
  version=$(head -1 "$TEMP_DIR/$pkg.txt")
  checksum=$(tail -1 "$TEMP_DIR/$pkg.txt")

  log_success "$pkg fetched"
  echo "  Version:  $version"
  echo "  Checksum: ${checksum:0:16}..."
  print_separator
}

fetch_github_package() {
  local pkg=$1
  local repo=$2
  local asset_pattern=$3

  # Get latest release version from GitHub API
  local latest_version
  latest_version=$(curl -s "https://api.github.com/repos/$repo/releases/latest" | grep '"tag_name":' | sed -E 's/.*"tag_name": "([^"]+)".*/\1/')

  # Remove 'v' prefix if present
  local version_number=${latest_version#v}

  # Replace {VERSION} placeholder in asset pattern
  local asset_name
  asset_name=$(echo "$asset_pattern" | sed "s/{VERSION}/$version_number/g")

  if [[ "$USE_DOCKER" == "true" ]]; then
    # Docker mode: Download in isolated container
    docker run --rm --name "github-release_$pkg" registry.suse.com/bci/bci-base:latest bash -c "
      curl -sL https://github.com/$repo/releases/download/${latest_version}/${asset_name} -o /tmp/${pkg}_asset
      echo \"$latest_version\"
      sha256sum /tmp/${pkg}_asset | cut -d' ' -f1
    " > "$TEMP_DIR/$pkg.txt" 2>&1
  else
    # CI mode: Download directly on runner
    {
      curl -sL "https://github.com/$repo/releases/download/${latest_version}/${asset_name}" -o "/tmp/${pkg}_asset"
      echo "$latest_version"
      sha256sum "/tmp/${pkg}_asset" | cut -d' ' -f1
      rm -f "/tmp/${pkg}_asset"  # Cleanup
    } > "$TEMP_DIR/$pkg.txt" 2>&1
  fi

  # Read results
  local version
  local checksum
  version=$(head -1 "$TEMP_DIR/$pkg.txt")
  checksum=$(tail -1 "$TEMP_DIR/$pkg.txt")

  log_success "$pkg fetched"
  echo "  Version:  $version"
  echo "  Checksum: ${checksum:0:16}..."
  print_separator
}

fetch_all_versions() {
  log_success "fetch_all_versions"
  log_info "Fetching latest versions (parallel execution)..."
  log_debug "Temp directory: $TEMP_DIR"
  echo ""

  local pids=()

  # Fetch zypper packages in parallel
  log_debug "Launching ${#PACKAGES[@]} zypper package fetches in parallel"
  for pkg in "${!PACKAGES[@]}"; do
    IFS=':' read -r binary_path display_name <<< "${PACKAGES[$pkg]}"
    (
      fetch_zypper_package "$pkg" "$binary_path"
    ) &
    pids+=($!)
    log_debug "Background job started for $pkg (PID: $!)"
  done

  # Fetch GitHub release packages in parallel
  log_debug "Launching ${#GITHUB_PACKAGES[@]} GitHub package fetches in parallel"
  for pkg in "${!GITHUB_PACKAGES[@]}"; do
    IFS=':' read -r install_path display_name repo asset_pattern <<< "${GITHUB_PACKAGES[$pkg]}"
    (
      fetch_github_package "$pkg" "$repo" "$asset_pattern"
    ) &
    pids+=($!)
    log_debug "Background job started for $pkg (PID: $!)"
  done

  # Wait for all background jobs
  log_debug "Waiting for ${#pids[@]} background jobs to complete"
  local failed_jobs=0
  for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
      log_error "Background job $pid failed"
      failed_jobs=$((failed_jobs + 1))
    fi
  done

  # Abort if any jobs failed
  if [[ $failed_jobs -gt 0 ]]; then
    log_error "$failed_jobs package fetch(es) failed"
    cleanup
    exit 1
  fi

  echo ""
  log_success "All packages fetched successfully"
  echo ""
}

parse_current_values() {
  log_success "parse_current_values"
  log_info "Parsing current values from $ACTION_FILE..."

  # Parse zypper packages
  log_debug "Processing ${#PACKAGES[@]} zypper packages"
  for pkg in "${!PACKAGES[@]}"; do
    IFS=':' read -r binary_path display_name <<< "${PACKAGES[$pkg]}"

    log_debug "Parsing $pkg (display_name: $display_name)"
    CURRENT_VERSIONS[$pkg]=$(get_current_version "$display_name")
    CURRENT_CHECKSUMS[$pkg]=$(get_current_checksum "$display_name")
    NEW_VERSIONS[$pkg]=$(head -1 "$TEMP_DIR/$pkg.txt")
    NEW_CHECKSUMS[$pkg]=$(tail -1 "$TEMP_DIR/$pkg.txt")

    log_debug "$pkg: current=${CURRENT_VERSIONS[$pkg]} | new=${NEW_VERSIONS[$pkg]}"
    log_debug "$pkg: current_checksum=${CURRENT_CHECKSUMS[$pkg]:0:16}... | new_checksum=${NEW_CHECKSUMS[$pkg]:0:16}..."
  done

  # Parse GitHub release packages
  log_debug "Processing ${#GITHUB_PACKAGES[@]} GitHub packages"
  for pkg in "${!GITHUB_PACKAGES[@]}"; do
    IFS=':' read -r install_path display_name repo asset_pattern <<< "${GITHUB_PACKAGES[$pkg]}"

    log_debug "Parsing $pkg (display_name: $display_name)"
    if [[ "$pkg" == "yq" ]]; then
      CURRENT_VERSIONS[$pkg]=$(get_current_yq_version "$display_name")
    elif [[ "$pkg" == "gh" ]]; then
      CURRENT_VERSIONS[$pkg]=$(get_current_gh_version "$display_name")
    fi
    CURRENT_CHECKSUMS[$pkg]=$(get_current_checksum "$display_name")
    NEW_VERSIONS[$pkg]=$(head -1 "$TEMP_DIR/$pkg.txt")
    NEW_CHECKSUMS[$pkg]=$(tail -1 "$TEMP_DIR/$pkg.txt")

    log_debug "$pkg: current=${CURRENT_VERSIONS[$pkg]} | new=${NEW_VERSIONS[$pkg]}"
    log_debug "$pkg: current_checksum=${CURRENT_CHECKSUMS[$pkg]:0:16}... | new_checksum=${NEW_CHECKSUMS[$pkg]:0:16}..."
  done

  log_success "Current values parsed"
  echo ""
}

build_comparison_table() {
  log_success "build_comparison_table"
  log_debug "Building comparison table for 9 packages"

  print_header "Dependency Comparison"
  echo ""

  printf "%-8s | %-30s | %-30s | %-13s\n" "Package" "Current Version" "Latest Version" "Should Update"
  printf "%s\n" "--------------------------------------------------------------------------------------------"

  local changes_detected=0
  for pkg in docker jq git make go patch gawk yq gh; do
    local current_ver="${CURRENT_VERSIONS[$pkg]}"
    local new_ver="${NEW_VERSIONS[$pkg]}"
    local current_sum="${CURRENT_CHECKSUMS[$pkg]}"
    local new_sum="${NEW_CHECKSUMS[$pkg]}"

    # Detect changes
    local should_update="no"
    if [[ "$current_ver" != "$new_ver" ]] || [[ "$current_sum" != "$new_sum" ]]; then
      changes_detected=1
      should_update="yes"
    fi

    # Truncate for display (keep first 30 chars for version)
    local current_ver_short="${current_ver:0:30}"
    local new_ver_short="${new_ver:0:30}"

    printf "%-8s | %-30s | %-30s | %-13s\n" \
      "$pkg" \
      "$current_ver_short" \
      "$new_ver_short" \
      "$should_update"
  done

  echo ""

  # Log detailed changes (only packages with changes)
  if [[ $changes_detected -gt 0 ]]; then
    log_debug "Packages with changes detected:"
    for pkg in docker jq git make go patch gawk yq gh; do
      local current_ver="${CURRENT_VERSIONS[$pkg]}"
      local new_ver="${NEW_VERSIONS[$pkg]}"
      local current_sum="${CURRENT_CHECKSUMS[$pkg]}"
      local new_sum="${NEW_CHECKSUMS[$pkg]}"

      if [[ "$current_ver" != "$new_ver" ]] || [[ "$current_sum" != "$new_sum" ]]; then
        log_debug "$pkg: CHANGE DETECTED"
        if [[ "$current_ver" != "$new_ver" ]]; then
          log_debug "  Version: $current_ver -> $new_ver"
        fi
        if [[ "$current_sum" != "$new_sum" ]]; then
          log_warning "  Checksum: ${current_sum:0:16}... -> ${new_sum:0:16}..."
        fi
      fi
    done
  fi

  # Return 0 (success) if changes detected, 1 (failure) if no changes
  if [[ $changes_detected -gt 0 ]]; then
    return 0
  else
    return 1
  fi
}

ask_confirmation() {
  log_success "ask_confirmation"
  print_separator

  if [[ -n "${CI}" ]]; then
    log_info "CI environment detected - auto-approving changes"
    log_debug "Skipping interactive prompt in CI mode"
    return 0
  fi

  log_debug "Prompting user for confirmation"
  read -p "Apply these changes to $ACTION_FILE? [(Y)es/(n)o]: " -n 1 -r
  echo ""

  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    log_warning "User declined changes"
    log_debug "User response: $REPLY"
    cleanup
    exit 0
  fi

  log_debug "User approved changes"
  return 0
}

apply_updates() {
  log_success "apply_updates"
  log_info "Applying updates to $ACTION_FILE..."
  echo ""

  # Update zypper packages
  log_debug "Updating zypper packages"
  for pkg in "${!PACKAGES[@]}"; do
    IFS=':' read -r binary_path display_name <<< "${PACKAGES[$pkg]}"

    local current_ver="${CURRENT_VERSIONS[$pkg]}"
    local new_ver="${NEW_VERSIONS[$pkg]}"
    local current_sum="${CURRENT_CHECKSUMS[$pkg]}"
    local new_sum="${NEW_CHECKSUMS[$pkg]}"

    if [[ "$current_ver" != "$new_ver" ]] || [[ "$current_sum" != "$new_sum" ]]; then
      log_info "Updating $pkg..."

      # Escape special characters for sed
      local current_ver_escaped
      local new_ver_escaped
      local current_sum_escaped
      local new_sum_escaped
      current_ver_escaped=$(escape_for_sed "$current_ver")
      new_ver_escaped=$(escape_for_sed "$new_ver")
      current_sum_escaped=$(escape_for_sed "$current_sum")
      new_sum_escaped=$(escape_for_sed "$new_sum")

      # Update version
      log_debug "$pkg: Updating version in $ACTION_FILE"
      log_debug "$pkg: $current_ver -> $new_ver"
      sed -i "/- name: Install $display_name/,/BINARY_PATH:/ s/PACKAGE_VERSION: \"$current_ver_escaped\"/PACKAGE_VERSION: \"$new_ver_escaped\"/" "$ACTION_FILE"

      # Update checksum
      log_debug "$pkg: Updating checksum in $ACTION_FILE"
      log_debug "$pkg: ${current_sum:0:16}... -> ${new_sum:0:16}..."
      sed -i "/- name: Install $display_name/,/BINARY_PATH:/ s/EXPECTED_CHECKSUM: \"$current_sum_escaped\"/EXPECTED_CHECKSUM: \"$new_sum_escaped\"/" "$ACTION_FILE"
    fi
  done

  # Update GitHub release packages
  log_debug "Updating GitHub packages"
  for pkg in "${!GITHUB_PACKAGES[@]}"; do
    IFS=':' read -r install_path display_name repo asset_pattern <<< "${GITHUB_PACKAGES[$pkg]}"

    local current_ver="${CURRENT_VERSIONS[$pkg]}"
    local new_ver="${NEW_VERSIONS[$pkg]}"
    local current_sum="${CURRENT_CHECKSUMS[$pkg]}"
    local new_sum="${NEW_CHECKSUMS[$pkg]}"

    if [[ "$current_ver" != "$new_ver" ]] || [[ "$current_sum" != "$new_sum" ]]; then
      log_info "Updating $pkg..."

      # Escape special characters for sed
      local current_ver_escaped
      local new_ver_escaped
      local current_sum_escaped
      local new_sum_escaped
      current_ver_escaped=$(escape_for_sed "$current_ver")
      new_ver_escaped=$(escape_for_sed "$new_ver")
      current_sum_escaped=$(escape_for_sed "$current_sum")
      new_sum_escaped=$(escape_for_sed "$new_sum")

      # Determine version variable name based on package
      local version_var=""
      if [[ "$pkg" == "yq" ]]; then
        version_var="YQ_VERSION"
      elif [[ "$pkg" == "gh" ]]; then
        version_var="GH_VERSION"
      fi

      # Update version
      log_debug "$pkg: Updating $version_var in $ACTION_FILE"
      log_debug "$pkg: $current_ver -> $new_ver"
      sed -i "/- name: Install $display_name/,/INSTALL_PATH:/ s/${version_var}: \"$current_ver_escaped\"/${version_var}: \"$new_ver_escaped\"/" "$ACTION_FILE"

      # Update checksum
      log_debug "$pkg: Updating checksum in $ACTION_FILE"
      log_debug "$pkg: ${current_sum:0:16}... -> ${new_sum:0:16}..."
      sed -i "/- name: Install $display_name/,/INSTALL_PATH:/ s/EXPECTED_CHECKSUM: \"$current_sum_escaped\"/EXPECTED_CHECKSUM: \"$new_sum_escaped\"/" "$ACTION_FILE"
    fi
  done

  echo ""
  log_success "Changes applied successfully"
}

print_next_steps() {
  log_success "print_next_steps"
  echo ""
  print_header "Next Steps"
  echo ""
  echo "Review changes:"
  echo "  git diff $ACTION_FILE"
  echo ""
  echo "Test changes locally:"
  echo "  act -j test-dependencies --container-architecture linux/amd64"
  echo ""
}

# ============================================================================
# Main
# ============================================================================

main() {
  log_success "main"
  log_debug "Script started"
  log_debug "Working directory: $(pwd)"
  log_debug "ACTION_FILE: $ACTION_FILE"

  # Detect execution mode
  detect_mode

  # Fetch latest versions in parallel
  fetch_all_versions

  # Parse current values from action.yaml
  parse_current_values

  # Build comparison table and check for changes
  if ! build_comparison_table; then
    log_success "No changes detected - all packages are up to date"
    log_debug "Cleaning up and exiting"
    cleanup
    exit 0
  fi

  # Ask for confirmation (or auto-approve in CI)
  ask_confirmation

  # Apply updates to action.yaml
  apply_updates

  # Cleanup temp directory
  log_debug "Cleaning up temp directory"
  cleanup

  # Print next steps
  print_next_steps

  log_debug "Script completed successfully"
}

main "$@"
