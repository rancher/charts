#!/bin/bash

cd $(dirname $0)
cd ..

if [ -n "$(git status --porcelain)" ]; then
    echo "Git needs to be clean to run this script"
    exit 1
fi

ORIG_PACKAGE=${PACKAGE}

# Temporary hardcoded package list for testing
packageList="elemental/elemental elemental/elemental-crd fleet harvester/harvester-cloud-provider harvester/harvester-csi-driver longhorn/longhorn/longhorn-1.10 longhorn/longhorn/longhorn-1.6 longhorn/longhorn/longhorn-1.7 longhorn/longhorn/longhorn-1.8 longhorn/longhorn/longhorn-1.9 longhorn/longhorn-crd/longhorn-1.10 longhorn/longhorn-crd/longhorn-1.6 longhorn/longhorn-crd/longhorn-1.7 longhorn/longhorn-crd/longhorn-1.8 longhorn/longhorn-crd/longhorn-1.9 neuvector neuvector-monitor rancher-aks-operator rancher-alerting/rancher-alerting-drivers rancher-alerting/rancher-prom2teams rancher-alerting/rancher-sachet rancher-ali-operator rancher-backup rancher-compliance rancher-csp-adapter rancher-eks-operator rancher-gke-operator rancher-istio/1.24/rancher-istio rancher-istio/1.24/rancher-kiali-server rancher-istio/1.24/rancher-tracing rancher-istio/1.25/rancher-istio rancher-istio/1.25/rancher-kiali-server rancher-istio/1.25/rancher-tracing rancher-logging rancher-monitoring/prometheus-federator rancher-monitoring/rancher-monitoring rancher-nfd rancher-sriov rancher-turtles rancher-webhook remotedialer-proxy suse-observability-agent system-upgrade-controller ui-plugin-operator"

FAILED_PACKAGES=()
for package in $packageList; do
    export PACKAGE="${package#packages\/}"

    # Do developer workflow
    if ! make prepare > /dev/null 2>&1; then
        FAILED_PACKAGES+=("- ${PACKAGE} failed at prepare")
    elif ! make icon > /dev/null 2>&1; then
        FAILED_PACKAGES+=("- ${PACKAGE} failed at icon")
    elif ! make patch > /dev/null 2>&1; then
        FAILED_PACKAGES+=("- ${PACKAGE} failed at patch")
    elif ! make clean > /dev/null 2>&1; then
        FAILED_PACKAGES+=("- ${PACKAGE} failed at clean")
    elif [ -n "$(git status --porcelain)" ]; then
        FAILED_PACKAGES+=("- ${PACKAGE} generated additional changes: $(git status --porcelain | xargs)")
    elif ! make charts > /dev/null 2>&1; then
        FAILED_PACKAGES+=("- ${PACKAGE} failed at charts")
    else
        echo "${PACKAGE} passed ci"
    fi

    git clean -df > /dev/null 2>&1
    git checkout -- . > /dev/null 2>&1
done

echo ""
if [ ${#FAILED_PACKAGES[@]} -ne 0 ]; then
    echo "Failed to pass ci for the following packages:"
    printf '%s\n' "${FAILED_PACKAGES[@]}"
else
    echo "All packages pass ci!"
fi

export PACKAGE=${ORIG_PACKAGE}
unset ORIG_PACKAGE