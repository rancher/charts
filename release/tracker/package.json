    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
