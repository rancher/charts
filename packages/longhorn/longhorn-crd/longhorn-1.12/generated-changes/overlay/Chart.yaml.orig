annotations:
  helm.sh/images: |-
    - name: longhorn-engine
      image: longhornio/longhorn-engine:v1.12.2
    - name: longhorn-manager
      image: longhornio/longhorn-manager:v1.12.2
    - name: longhorn-ui
      image: longhornio/longhorn-ui:v1.12.2
    - name: longhorn-instance-manager
      image: longhornio/longhorn-instance-manager:v1.12.2
    - name: longhorn-share-manager
      image: longhornio/longhorn-share-manager:v1.12.2
    - name: backing-image-manager
      image: longhornio/backing-image-manager:v1.12.2
    - name: support-bundle-kit
      image: longhornio/support-bundle-kit:v1.0.5
    - name: csi-attacher
      image: longhornio/csi-attacher:v4.13.0-20261028
    - name: csi-provisioner
      image: longhornio/csi-provisioner:v5.3.0-20261028
    - name: csi-node-driver-registrar
      image: longhornio/csi-node-driver-registrar:v2.18.0-20261028
    - name: csi-resizer
      image: longhornio/csi-resizer:v2.3.0-20261028
    - name: csi-snapshotter
      image: longhornio/csi-snapshotter:v8.7.0-20261028
    - name: livenessprobe
      image: longhornio/livenessprobe:v2.20.0-20261028
apiVersion: v1
appVersion: v1.12.2
description: Longhorn is a distributed block storage system for Kubernetes.
home: https://github.com/longhorn/longhorn
icon: https://raw.githubusercontent.com/cncf/artwork/master/projects/longhorn/icon/color/longhorn-icon-color.png
keywords:
- longhorn
- storage
- distributed
- block
- device
- iscsi
- nfs
kubeVersion: '>=1.25.0-0'
maintainers:
- email: maintainers@longhorn.io
  name: Longhorn maintainers
name: longhorn
sources:
- https://github.com/longhorn/longhorn
- https://github.com/longhorn/longhorn-engine
- https://github.com/longhorn/longhorn-instance-manager
- https://github.com/longhorn/longhorn-share-manager
- https://github.com/longhorn/longhorn-manager
- https://github.com/longhorn/longhorn-ui
- https://github.com/longhorn/longhorn-tests
- https://github.com/longhorn/backing-image-manager
version: 1.12.2
